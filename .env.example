# llamaswap configuration
#
# Copy this file to `.env` and adjust any values you need:
#
#     cp .env.example .env
#
# Docker Compose reads `.env` from the project directory automatically and
# substitutes the values into the container via the ${VAR:-default} entries in
# docker-compose.yml. scripts/deploy.sh sources the same file before applying
# its own defaults, so its path validations agree with what compose mounts.
# Precedence matches docker compose: a variable set in the shell environment
# wins over the .env value. Any variable left unset (or the whole .env
# removed) falls back to the default shown here, which mirrors the defaults
# in app/config.py.
#
# Every variable the app itself reads is prefixed LLAMASWAP_ (enforced by
# app/config.py). The "Compose / deploy-time" section at the top is the
# exception: those are substituted by `docker compose` / scripts/deploy.sh
# on the HOST side and never enter the container environment.
#
# Note: the real .env is excluded from the Docker image (.dockerignore) and
# is the right place for machine-specific overrides. Never commit it.

# --- Compose / deploy-time variables (host side only) ---
# Shared model root on the host: llama.cpp weights, the download-managed
# TTS/ASR/music/image bundles (scripts/download-models.sh) and the Strata
# shards/packs all live here, mounted at /opt/models in the container.
# May be a symlink — e.g. `sudo ln -sfn /mnt/d/MODELS /opt/models`.
MODEL_ROOT=/opt/models
# Strata install on the host (terminal bundle + engine components),
# mounted read-only at the fixed container path /opt/strata/.local/share/
# strata by docker-compose.hub.yml and docker-compose.strata.yml. Leave
# unset for the default (~/.local/share/strata). Without an install the
# Strata models simply sit unused in the registry.
STRATA_HOME=
# Model disk for the STACKED LOCAL strata overlay only; deploy.sh defaults
# it to $MODEL_ROOT. Leave unset unless your Strata weights live outside
# the shared model root (the hub deployment has no separate mount).
STRATA_MODELS=
# Optional explicit version pins for the Strata backend paths. Leave unset:
# deploy.sh sniffs them off the install and the container entrypoint
# re-sniffs at startup — set them only if the sniff cannot match your
# install's layout.
STRATA_TERMINAL_VERSION=
STRATA_ENGINE_DIR=

# --- Proxy (OpenAI-compatible) listener ---
# Host/interface the proxy binds to inside the container.
LLAMASWAP_HOST=0.0.0.0
# Port the proxy listens on inside the container.
LLAMASWAP_PORT=11434

# --- Model registry ---
# Directory holding the per-model *.yaml registry files. In docker-compose this
# is a host mount, so leave it as `backend` unless you change the volume.
LLAMASWAP_BACKEND_DIR=backend

# --- Process lifecycle ---
# Max seconds to wait for a backend /health check after launching a model.
# 1800 covers the Strata pack's cold first load (~13 min after a reboot);
# every other backend loads in seconds, so the inflated ceiling is
# harmless. Do not lower it back to 600 with Strata in use.
LLAMASWAP_STARTUP_TIMEOUT=1800.0
# SIGTERM grace period (seconds) before SIGKILL when unloading a llama-server.
LLAMASWAP_STOP_TIMEOUT=30.0
# Health-check poll cadence (seconds) during model startup.
LLAMASWAP_HEALTH_INTERVAL=1.0
# Unload the loaded chat LLM AND the tts/asr servers after this many
# seconds with no requests (only the embedding server stays up).
# 0 disables idle unload.
LLAMASWAP_IDLE_UNLOAD_SECONDS=300
# Per-role idle-unload overrides (seconds). Leave unset to inherit
# LLAMASWAP_IDLE_UNLOAD_SECONDS; 0 disables idle unload for that role.
LLAMASWAP_IDLE_UNLOAD_AUDIO_SECONDS=
LLAMASWAP_IDLE_UNLOAD_IMAGE_SECONDS=
LLAMASWAP_IDLE_UNLOAD_MUSIC_SECONDS=
# VRAM guard: while tts AND asr are both loaded, only the smallest chat
# LLM (by weights-file size) is served, regardless of the requested
# model. Set false to disable.
LLAMASWAP_AUDIO_VRAM_GUARD=true
# Inverse guard: reject TTS/ASR with 409 while a "big" chat LLM (any model
# other than the smallest by weights-file size) is loaded. Set false to
# allow audio alongside a big LLM.
LLAMASWAP_BLOCK_AUDIO_ON_BIG_LLM=true
# Unload TTS/ASR when a "big" chat LLM is requested (embedding stays up).
# Set false to keep audio loaded instead — then the audio_vram_guard may
# downgrade the chat request to the smallest model.
LLAMASWAP_UNLOAD_AUDIO_ON_BIG_LLM=true
# Image-generation VRAM guard: stop the chat LLM + TTS/ASR + embedding
# servers before loading the image server, freeing the whole GPU. Set
# false to keep them loaded — a diffusion model may then not fit.
LLAMASWAP_UNLOAD_ON_IMAGE=true
# Stop the image server before serving any chat request so the LLM fits.
LLAMASWAP_UNLOAD_IMAGE_ON_LLM=true
# Stop the image server before serving any TTS/ASR request so audio
# never stacks on top of the diffusion model.
LLAMASWAP_UNLOAD_IMAGE_ON_AUDIO=true
# Launch the embedding server (octen-embedding) automatically at boot and
# keep it running for the lifetime of the proxy (only stopped to free
# VRAM). Default false: boot it on first use instead, like the
# chat/TTS/ASR/image endpoints — nothing starts until the first
# /v1/embeddings request.
LLAMASWAP_EMBEDDING_AUTO_START=false
# Where the proxy stages uploaded audio for backends that expect a
# server-side file path (audio.cpp transcriptions). Must be writable by
# llamaswap and readable by the audio backend process.
LLAMASWAP_AUDIO_TMP_DIR=/tmp/llamaswap-audio
# Where per-model config files for structured-config chat backends
# (e.g. strata serve --profile) are rendered before launch. Must be
# writable by llamaswap and readable by the backend process.
LLAMASWAP_LLM_TMP_DIR=/tmp/llamaswap-llm
# Log level: DEBUG, INFO, WARNING, ERROR.
LLAMASWAP_LOG_LEVEL=INFO
# Structured JSON logging (one object per line) when true.
LLAMASWAP_LOG_JSON=false

# --- Authentication (optional) ---
# When set, every /v1/* request (and the dashboard at /) must present this
# key as `Authorization: Bearer <key>` or `X-Api-Key: <key>`.
# /health and /metrics stay open for probes and scraping.
LLAMASWAP_API_KEY=
# Admin key gating /v1/reset, /v1/registry/reload, and
# /v1/models/{model}/load|unload. Falls back to LLAMASWAP_API_KEY when unset.
LLAMASWAP_ADMIN_KEY=

# --- Backpressure ---
# Maximum concurrently in-flight HTTP requests before 429 + Retry-After.
# 0 disables the limit.
LLAMASWAP_MAX_CONCURRENCY=0

# --- Tool-call recovery ---
# Re-emit tool calls the backend refused because their name was not declared
# (e.g. an MCP tool the client namespaces as unity_unity_*, while the project's
# docs tell the model unity_*). false disables the layer entirely.
LLAMASWAP_TOOL_RECONCILE=true
# Minimum name similarity for a fuzzy match; raise it to stop trusting
# anything but exact/prefix-identical names. Default 0.75.
LLAMASWAP_TOOL_RECONCILE_MIN_RATIO=0.75
