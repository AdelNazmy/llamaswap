# llamaswap configuration
#
# Copy this file to `.env` and adjust any values you need:
#
#     cp .env.example .env
#
# Docker Compose reads `.env` from the project directory automatically and
# substitutes the values into the container via the ${VAR:-default} entries in
# docker-compose.yml. Any variable left unset (or the whole .env removed)
# falls back to the default shown here, which mirrors the defaults in
# app/config.py.
#
# Every variable is prefixed LLAMASWAP_ (enforced by app/config.py).
#
# Note: the real .env is excluded from the Docker image (.dockerignore) and
# is the right place for machine-specific overrides. Never commit it.

# --- Proxy (OpenAI-compatible) listener ---
# Host/interface the proxy binds to inside the container.
LLAMASWAP_HOST=0.0.0.0
# Port the proxy listens on inside the container.
LLAMASWAP_PORT=11434

# --- Model registry ---
# Directory holding the per-model *.yaml registry files. In docker-compose this
# is a host mount, so leave it as `backend` unless you change the volume.
LLAMASWAP_BACKEND_DIR=backend

# --- Process lifecycle ---
# Max seconds to wait for a llama-server /health check after launching a model.
LLAMASWAP_STARTUP_TIMEOUT=600.0
# SIGTERM grace period (seconds) before SIGKILL when unloading a llama-server.
LLAMASWAP_STOP_TIMEOUT=30.0
# Health-check poll cadence (seconds) during model startup.
LLAMASWAP_HEALTH_INTERVAL=1.0
# Unload the loaded chat LLM AND the tts/asr servers after this many
# seconds with no requests (only the embedding server stays up).
# 0 disables idle unload.
LLAMASWAP_IDLE_UNLOAD_SECONDS=600
# VRAM guard: while tts AND asr are both loaded, only the smallest chat
# LLM (by weights-file size) is served, regardless of the requested
# model. Set false to disable.
LLAMASWAP_AUDIO_VRAM_GUARD=true
# Inverse guard: reject TTS/ASR with 409 while a "big" chat LLM (any model
# other than the smallest by weights-file size) is loaded. Set false to
# allow audio alongside a big LLM.
LLAMASWAP_BLOCK_AUDIO_ON_BIG_LLM=true
# Unload TTS/ASR when a "big" chat LLM is requested (embedding stays up).
# Set false to keep audio loaded instead — then the audio_vram_guard may
# downgrade the chat request to the smallest model.
LLAMASWAP_UNLOAD_AUDIO_ON_BIG_LLM=true
# Log level: DEBUG, INFO, WARNING, ERROR.
LLAMASWAP_LOG_LEVEL=INFO
